# Feature flags (development only — production reads the FeatureFlag DB table instead)
FEATURE_AI_DRAFT_ASSIST=true

# SMTP (email sending for password reset / verification)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tessera <noreply@tessera.dev>"
