{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Tessera — GraphQL content & case-study platform. Structured content, one piece at a time.",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev",
    "build": "NODE_OPTIONS='--no-deprecation' next build",
    "start": "NODE_OPTIONS='--no-deprecation' next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "codegen": "graphql-codegen",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@apollo/client": "^4.2.12",
    "@apollo/server": "^5.5.1",
    "@hookform/resolvers": "^5.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "@teispace/next-themes": "^3.0.0",
    "antd": "^6.6.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.1",
    "graphql": "^16.9.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-tag": "^2.12.6",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-resources-to-backend": "^1.2.0",
    "next": "^16.3.2",
    "nodemailer": "^9.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^17.0.12",
    "react-icons": "^5.7.0",
    "sass": "^1.90.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.0.0",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/client-preset": "^5.0.0",
    "@playwright/test": "^1.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "playwright": "^1.0.0",
    "postcss": "^8.0.0",
    "prettier": "^3.9.6",
    "prisma": "^7.0.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,scss,css,md}": [
      "prettier --write"
    ]
  }
}
